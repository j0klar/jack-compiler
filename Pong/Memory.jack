/**
 * This library provides two services: direct access to the computer's main
 * memory (RAM), and allocation and recycling of memory blocks. The Hack RAM
 * consists of 32,768 words, each holding a 16-bit binary number.
 */ 
class Memory {
    static Array ram;
    static int heapBase;

    /** Initializes the class. */
    function void init() {
        let ram = 0; // ram base address
        let heapBase = 2048; // heap base pointer
        let ram[2048] = 0; // next list pointer
        let ram[2049] = 14334; // current list size
        return;
    }

    /** Returns the RAM value at the given address. */
    function int peek(int addr) {
        return ram[addr];
    }

    /** Sets the RAM value at the given address to the given value. */
    function void poke(int addr, int value) {
        let ram[addr] = value;
        return;
    }

    /** Finds an available RAM block of the given size and returns
     *  a reference to its base address. */
    function int alloc(int size) {
        var int block, next;
        let next = heapBase;
        while (ram[next + 1] < (size + 2)) {
            let next = ram[next];
            if (next = 0) {
                do Sys.error(1);
                return;
            }
        }
        let block = next + 2 + ram[next + 1] - size;
        let ram[block - 2] = 0;
        let ram[block - 1] = size;
        let ram[next + 1] = ram[next + 1] - size - 2;
        return block;
    }

    /** De-allocates the given object (cast as an array) by making
     *  it available for future allocations. */
    function void deAlloc(Array o) {
        var int next;
        let next = heapBase;
        while (~(ram[next] = 0)) {
            let next = ram[next];
        }
        let ram[next] = o - 2;
        let ram[o - 2] = 0;
        return;
    }
}
