/**
 * A library of functions for displaying graphics on the screen.
 * The Hack physical screen consists of 256 rows (indexed 0..255, top to bottom)
 * of 511 pixels each (indexed 0..511, left to right). The top left pixel on 
 * the screen is indexed (0,0).
 */
class Screen {
    static boolean color;     // Represents current color (b/w)
    static Array powersOfTwo; // Stores 2^0, 2^1, 2^2,..., 2^15

    /** Initializes the Screen. */
    function void init() {
        var int i, sum;
        let powersOfTwo = Array.new(16);
        let i = 0;
        let sum = 1;
        while (i < 16) {
            let powersOfTwo[i] = sum;
            let sum = sum + sum;
            let i = i + 1;
        }
        let color = true;
        return;
    }

    /** Erases the entire screen. */
    function void clearScreen() {
        var int addr;
        let addr = 16384;
        while (addr < 24576) {
            do Memory.poke(addr, 0);
            let addr = addr + 1;
        }
        return;
    }

    /** Sets the current color, to be used for all subsequent drawXXX commands.
     *  Black is represented by true, white by false. */
    function void setColor(boolean c) {
        let color = c;
        return;
    }

    /** Draws the (x,y) pixel, using the current color. */
    function void drawPixel(int x, int y) {
        var int addr, word, bit, xOver16;
        let xOver16 = x / 16;
        let addr = 16384 + (y * 32) + xOver16;
        let word = Memory.peek(addr);
        let bit = powersOfTwo[(x - (xOver16 * 16))];
        if (color) {
            let word = word | bit;
        } else {
            let word = word & (~bit);
        }        
        do Memory.poke(addr, word);
        return;
    }

    /** Draws a line from pixel (x1,y1) to pixel (x2,y2), using the current color. */
    function void drawLine(int x1, int y1, int x2, int y2) {
        var int x, y, dx, dy, a, b, diff, xDir, yDir;
        let x = x1;
        let y = y1;
        let dx = x2 - x1;
        let dy = y2 - y1;
        let a = 0;
        let b = 0;
        // Draw straight line
        if (dx = 0) {
            if (dy < 0) {
                let y = y2;
                let dy = -dy;
            }
            while (~(b > dy)) {
                do Screen.drawPixel(x, y + b);
                let b = b + 1;
            }  
            return;
        } 
        if (dy = 0) {
            if (dx < 0) {
                let x = x2;
                let dx = -dx;
            }
            while (~(a > dx)) {
                do Screen.drawPixel(x + a, y);
                let a = a + 1;
            }    
            return;
        }  
        // Draw diagonal line
        let xDir = 1;
        let yDir = 1;
        if (dx < 0) {
            let dx = -dx;
            let xDir = -1;
        }
        if (dy < 0) {
            let dy = -dy;
            let yDir = -1;
        }
        let diff = 0;
        while (~(a > dx) & ~(b > dy)) {
            do Screen.drawPixel(x + (a * xDir), y + (b * yDir));
            if (diff < 0) {
                let a = a + 1;
                let diff = diff + dy;
            } else {
                let b = b + 1;
                let diff = diff - dx;
            }
        }
        return;
    }

    /** Draws a filled rectangle whose top left corner is (x1, y1)
     *  and bottom right corner is (x2,y2), using the current color. */
    function void drawRectangle(int x1, int y1, int x2, int y2) {
        var int y;
        let y = y1;
        while (~(y > y2)) {
            do Screen.drawLine(x1, y, x2, y);
            let y = y + 1;
        }
        return;
    }

    /** Draws a filled circle of radius r<=181 around (x,y), using the current color. */
    function void drawCircle(int x, int y, int r) {
        var int dy, dist, r2;
        if (r > 181) {
            do Sys.error(2);
        }
        let dy = -r;
        let r2 = r * r;
        while (~(dy > r)) {
            let dist = Math.sqrt(r2 - (dy * dy));
            do Screen.drawLine(x - dist, y + dy, x + dist, y + dy);
            let dy = dy + 1;
        }
        return;
    }
}
